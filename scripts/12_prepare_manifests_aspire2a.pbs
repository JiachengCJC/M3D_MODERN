#!/bin/bash
#PBS -P personal-e1129906
#PBS -q normal
#PBS -N M3D_MANIFESTS
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#
# ASPIRE 2A manifest preparation job
# =================================================
# 原始 JSON、CSV 和医学影像文件
#               ↓
# 检查、整理、分类
#               ↓
# 生成 train / validation / test 清单
#               ↓
# 训练程序按照清单读取数据

set -Eeuo pipefail
PROJECT_ROOT="${M3D_PROJECT_ROOT:-${PBS_O_WORKDIR}}"
CONFIG="${M3D_CONFIG:-${PROJECT_ROOT}/configs/m3d_joint_finetune.yaml}"
VENV="${M3D_VENV_DIR:-${PROJECT_ROOT}/.venv}"
SPLITS="${M3D_SPLITS:-train validation test}"
LOG_DIR="${PROJECT_ROOT}/logs/manifests/${PBS_JOBID:-manual}"
mkdir -p "${LOG_DIR}"
exec > >(stdbuf -oL tee -a "${LOG_DIR}/manifest.log") 2>&1

type module >/dev/null 2>&1 || {
    echo "The ASPIRE 2A module command is unavailable."
    exit 2
}

module reset >/dev/null 2>&1 || module purge
module load python/3.10.9
hash -r

[[ -x "${VENV}/bin/python" ]] || {
    echo "Virtual environment is missing or invalid: ${VENV}"
    exit 2
}

source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}" # 设置使用 OpenMP 的程序最多使用 8 个线程。

# 检查配置文件是否存在并且是普通文件。如果不存在，则输出错误信息并退出。
[[ -f "${CONFIG}" ]] || { echo "Missing config: ${CONFIG}"; exit 2; }

# 把 split 字符串转换成 Bash 数组，SPLIT_ARGS[0]=train, SPLIT_ARGS[1]=validation, SPLIT_ARGS[2]=test
read -r -a SPLIT_ARGS <<< "${SPLITS}"

# 运行 manifest 准备脚本，传入配置文件和数据集划分参数。如果设置了 M3D_SKIP_FILE_VALIDATION 环境变量为 1，则添加 --no-verify-files 参数以跳过文件验证。
ARGS=(--config "${CONFIG}" --splits "${SPLIT_ARGS[@]}")
[[ "${M3D_SKIP_FILE_VALIDATION:-0}" == "1" ]] && ARGS+=(--no-verify-files)

python -m m3d.data.manifest "${ARGS[@]}"

echo "Manifest preparation complete."
